<%-- ============================================================ --%>
<%-- 📌 JSP 페이지 기본 설정                                        --%>
<%-- 모든 JSP 파일의 첫 줄에 반드시 있어야 하는 선언                 --%>
<%-- ============================================================ --%>
<%@ page contentType="text/html;charset=UTF-8" language="java" %>

<%-- ============================================================ --%>
<%-- [footer.jsp] 모든 페이지에 포함되는 공통 푸터(하단)              --%>
<%-- ============================================================ --%>
<%-- 역할: 메인 콘텐츠 닫기(</main>), 푸터 영역, Bootstrap JS 로드, --%>
<%--       HTML 닫기 태그(</body></html>)                           --%>
<%--                                                               --%>
<%-- 사용 방법: 다른 JSP 파일 맨 아래에서                           --%>
<%--   <jsp:include page="../common/footer.jsp"/> 로 포함           --%>
<%--                                                               --%>
<%-- 중요: header.jsp에서 열린 <main> 태그를 여기서 닫습니다!       --%>
<%--       header.jsp + 본문 + footer.jsp = 하나의 완전한 HTML 페이지--%>
<%-- 비유: 샌드위치의 아래쪽 빵 역할                                --%>
<%-- Controller: 별도 컨트롤러 없음 (포함되는 파일)                 --%>
<%-- ============================================================ --%>

<%-- header.jsp에서 열었던 <main> 태그를 닫음 --%>
<%-- 이로써 본문 영역이 종료됨 --%>
</main>
<!-- 메인 콘텐츠 끝 -->

<%-- ============================================================ --%>
<%-- 📌 푸터 영역 (페이지 하단 정보)                                 --%>
<%-- Bootstrap 클래스 설명:                                         --%>
<%--   bg-dark → 어두운(거의 검정) 배경색                            --%>
<%--   text-light → 밝은(흰색) 글자색                                --%>
<%--   py-4 → padding-y(위아래 안쪽 여백) 4단위 (24px)              --%>
<%--   mt-auto → margin-top auto → 위쪽 여백을 자동으로 채움        --%>
<%--             (= 내용이 적어도 푸터가 항상 페이지 바닥에 위치)    --%>
<%-- ============================================================ --%>
<footer class="bg-dark text-light py-4 mt-auto">
    <%-- container: 내용을 중앙 정렬 --%>
    <%-- text-center: 텍스트를 가운데 정렬 --%>
    <div class="container text-center">
        <%-- mb-1: margin-bottom 1단위 (아래 여백 4px) --%>
        <p class="mb-1">
            <i class="bi bi-shop"></i> 팀 맛집 리스트
        </p>
        <%-- mb-0: 아래 여백 없음 --%>
        <%-- text-muted: 흐릿한(회색) 글자색 --%>
        <%-- small: 작은 글씨 --%>
        <%-- &copy; → 저작권 기호(©) HTML 특수문자 --%>
        <p class="mb-0 text-muted small">
            &copy; 2025 KH정보교육원 팀 프로젝트 | Spring Boot + JPA + JSP
        </p>
    </div>
</footer>

<%-- ============================================================ --%>
<%-- 📌 Bootstrap 5 JavaScript 번들 로드                             --%>
<%-- bootstrap.bundle.min.js에는 Popper.js가 포함되어 있음           --%>
<%-- Popper.js: 드롭다운 메뉴, 툴팁 등의 위치 계산 라이브러리       --%>
<%-- 이 JS가 있어야 네비게이션 바의 햄버거 메뉴, 드롭다운 등이 작동 --%>
<%-- 비유: 자동차의 엔진(CSS가 차체라면, JS는 엔진)                 --%>
<%-- ============================================================ --%>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<%-- header.jsp에서 열었던 <body>와 <html> 태그를 닫음 --%>
<%-- 모든 HTML 문서는 반드시 이 닫는 태그로 끝나야 함 --%>
</body>
</html>
